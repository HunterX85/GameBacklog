// Template for Secrets.xcconfig.
//
// Copy this file to "Secrets.xcconfig" (same folder) and fill in the real
// values from the Twitch Developer Console (dev.twitch.tv/console/apps).
// Secrets.xcconfig itself is gitignored — never commit real credentials.

IGDB_CLIENT_ID = your_client_id_here
IGDB_CLIENT_SECRET = your_client_secret_here

// Supabase project settings (Project Settings > API in the Supabase dashboard).
// SUPABASE_URL_HOST is just the host — no scheme — to dodge xcconfig's "//
// starts a comment" parsing rule.
SUPABASE_URL_HOST = your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = your_publishable_key_here
