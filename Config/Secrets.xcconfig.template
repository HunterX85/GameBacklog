// Template for Secrets.xcconfig.
//
// Copy this file to "Secrets.xcconfig" (same folder) and fill in the real
// values. Secrets.xcconfig itself is gitignored — never commit real credentials.
//
// IGDB's Twitch Client ID/Secret are NOT configured here — they live as
// Supabase Edge Function secrets (Dashboard > Edge Functions > Secrets) for
// the `igdb-token` function, never in the app bundle.

// Supabase project settings (Project Settings > API in the Supabase dashboard).
// SUPABASE_URL_HOST is just the host — no scheme — to dodge xcconfig's "//
// starts a comment" parsing rule.
SUPABASE_URL_HOST = your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = your_publishable_key_here
